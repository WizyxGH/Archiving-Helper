# Environment & Credentials
.env
*.env
.env.local
.env.*.local
# Sauvegardes de .env : mêmes secrets, et '.env*' ne les couvre pas car le nom
# ne se termine pas par « .env ». Sans ces lignes, un .env.bak committé expose
# TELEGRAM_API_HASH.
.env.bak
.env.backup
.env-*
*.env.bak
*.env.backup

# Telegram Sessions
*.session
*.session-journal

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

