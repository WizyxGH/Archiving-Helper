# Debrider & Host API Configuration
# Rename this file to .env and fill in your API token(s).
# The downloader will automatically use these tokens to unrestrict Rapidgator, 1fichier, DDownload, etc. at 100+ MB/s!

# ── 1. Real-Debrid (Recommended - unlocks Rapidgator, DDownload, 1fichier, Mega, etc.)
# Get your API token here: https://real-debrid.com/apitoken
REALDEBRID_API_KEY=

# ── 2. AllDebrid
# Get your API key here: https://alldebrid.com/apikeys
ALLDEBRID_API_KEY=

# ── 3. Debrid-Link
# Get your key here: https://debrid-link.com/webapp/register
DEBRIDLINK_API_KEY=

# ── 4. 1fichier API Key (Direct high-speed without waiting)
# Get your API key here: https://1fichier.com/console/params.cgi
ONEFICHIER_API_KEY=
