# Configuration d'Archiving Helper
#
# Copiez ce fichier en .env et ajustez les valeurs. Toutes les clés sont
# optionnelles : une ligne absente ou vide retombe sur la valeur par défaut
# définie dans src/core/config.mjs.
#
# Une variable d'environnement du même nom PRIME sur ce fichier, ce qui
# permet de surcharger une seule valeur sans éditer le .env :
#   TARGET_ARCHIVE_PATH=E:\Sauvegarde node src/cli/menu.mjs

# --- Chemins ---------------------------------------------------------------

# Racine d'archivage sur le disque de destination. Les tomes y sont ranges
# par publication/numero. Le rapport d'audit Telegram est ecrit a cote.
# Defaut : D:\Duckburg Archives\Disney comics
TARGET_ARCHIVE_PATH=

# Dossier contenant les fichiers .isv d'Inducks (issue, entry, publication).
# Cherche dans data/inducks du depot, puis dans ~/Downloads/inducks_extracted.
# Defaut : data/inducks
INDUCKS_DATA_DIR=

# Fichier .isv des publications, si different du dossier de donnees.
# Prioritaire sur INDUCKS_DATA_DIR pour cette ressource.
INDUCKS_PUBLICATIONS_ISV=

# Cache de la base de publications synchronisee.
# Defaut : ~/.cache/archiving-helper/inducks (Linux/macOS)
#         %USERPROFILE%\.cache\archiving-helper\inducks (Windows)
INDUCKS_CACHE_DIR=

# 1 = preparer le paquet d'envoi Inducks de chaque tome certifie (extrait toutes
# ses images dans le dossier de collection, 30 a 800 Mo par tome).
# Defaut : desactive
INDUCKS_PREPARE_UPLOAD=

# Dossier du CSV de collection et des paquets d'envoi Inducks.
# Defaut : download-files/files_downloads
INDUCKS_COLLECTION_DIR=

# Dossier du CSV d'audit Telegram et du journal des runs.
# Defaut : le dossier de collection ci-dessus (jamais le disque de la bibliotheque)
AUDIT_DIR=

# --- Executables externes --------------------------------------------------

# Chemin vers Rar.exe. Laisse vide, il est cherche dans le PATH puis dans les
# emplacements d'installation standard (Program Files\WinRAR).
# Une valeur definie mais introuvable leve une erreur explicite plutot que
# d'echouer plus tard avec un message obscur.
RAR_EXECUTABLE=

# --- Telegram (pipeline audit -> Drive) ------------------------------------

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNEL_URL=

# --- Debrid (optionnel) ----------------------------------------------------

REALDEBRID_API_KEY=
DEBRIDLINK_API_KEY=

# --- Affichage -------------------------------------------------------------

# Palier de rafraîchissement de la barre de progression, en pourcentage.
# Telegram emet plusieurs blocs par seconde : sans regroupement l'ecran
# defile sans arreter et masque les messages de fin d'etape.
#   5  -> 21 lignes par tome (detaille)
#   10 -> 11 lignes
#   20 -> 6 lignes (defaut, lisible)
#   0  -> barre desactivee
# Defaut : 20
PROGRESS_STEP_PCT=