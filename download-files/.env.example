# ==============================================================================
# Archiving Helper - Environment & API Configuration
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram API Configuration
# Get your free API credentials at: https://my.telegram.org (under 'API development tools')
# ------------------------------------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Default Telegram channel or group to archive/scan (URL or @username)
# e.g.: https://t.me/+AbCdEfGhIjKlMnOp or @my_comics_channel
TELEGRAM_CHANNEL_URL=

# ------------------------------------------------------------------------------
# 2. Storage & Library Paths
# ------------------------------------------------------------------------------
# Root destination library for archived comics (Inducks country/publication hierarchy)
TARGET_ARCHIVE_PATH=D:\Duckburg Archives\Disney comics

# Temporary staging folder on a non-C drive (avoids filling system disk during 1-by-1 downloads)
STAGING_PATH=D:\Duckburg Archives\_staging_temp

# ------------------------------------------------------------------------------
# 3. Debrider & Cloud Host API Keys (Optional - for download.mjs)
# ------------------------------------------------------------------------------
REALDEBRID_API_KEY=
ALLDEBRID_API_KEY=
DEBRIDLINK_API_KEY=
ONEFICHIER_API_KEY=
